{
  "name": "@rrrrrredy/dsh-agent-memory",
  "version": "0.1.0",
  "description": "DeepSeek Harness community Bundle for local, evidence-backed Agent Memory",
  "type": "module",
  "main": "./lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./package.json": "./package.json"
  },
  "files": ["lib", "cordis.patch.yml", "source-integrity.json", "LICENSE", "README.md"],
  "scripts": {
    "build": "node scripts/build.mjs",
    "test": "node --test tests/capture.test.mjs tests/config.test.mjs tests/plugin.test.mjs tests/process.test.mjs tests/retrieval.test.mjs",
    "test:integration": "node --test tests/cli-integration.test.mjs",
    "test:e2e": "node scripts/headless-e2e.mjs",
    "verify": "node scripts/verify.mjs",
    "verify:integration": "node scripts/verify.mjs && node --test tests/cli-integration.test.mjs",
    "prepack": "node scripts/verify.mjs"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  },
  "peerDependencies": {
    "@deepseek-ai/dsh-agent": "0.1.0-rc.6",
    "@deepseek-ai/dsh-llm": "0.1.0-rc.6",
    "@deepseek-ai/dsh-session": "0.1.0-rc.6",
    "@deepseek-ai/dsh-session-persistence": "0.1.0-rc.6",
    "@deepseek-ai/dsh-subprocess": "0.1.0-rc.6",
    "@deepseek-ai/schemastery": "3.18.1"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/dsh-agent": { "optional": true },
    "@deepseek-ai/dsh-llm": { "optional": true },
    "@deepseek-ai/dsh-session": { "optional": true },
    "@deepseek-ai/dsh-session-persistence": { "optional": true },
    "@deepseek-ai/dsh-subprocess": { "optional": true },
    "@deepseek-ai/schemastery": { "optional": true }
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "4.0.1",
    "@deepseek-ai/dsh-agent": "0.1.0-rc.6",
    "@deepseek-ai/dsh-llm": "0.1.0-rc.6",
    "@deepseek-ai/dsh-session": "0.1.0-rc.6",
    "@deepseek-ai/dsh-session-persistence": "0.1.0-rc.6",
    "@deepseek-ai/dsh-session-persistence-jsonl": "0.1.0-rc.6",
    "@deepseek-ai/dsh-subprocess": "0.1.0-rc.6",
    "@deepseek-ai/dsh-subprocess-local": "0.1.0-rc.6",
    "@deepseek-ai/schemastery": "3.18.1"
  },
  "packageManager": "pnpm@11.19.0",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/rrrrrredy/agent-memory-system.git",
    "directory": "integrations/deepseek-harness"
  },
  "homepage": "https://github.com/rrrrrredy/agent-memory-system/tree/main/integrations/deepseek-harness",
  "bugs": "https://github.com/rrrrrredy/agent-memory-system/issues",
  "keywords": ["deepseek-harness", "dsh-plugin", "agent", "memory", "event-log", "local-first"],
  "license": "MIT"
}
