{
  "description": "Durable lifecycle hints for local evidence reconciliation",
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"<absolute-agentmem>\" capture hook codex --root \"<local-evidence-directory>\"",
            "commandWindows": "\"<absolute-agentmem.exe>\" capture hook codex --root \"<local-evidence-directory>\"",
            "timeout": 3
          }
        ]
      }
    ],
    "UserPromptSubmit": [
