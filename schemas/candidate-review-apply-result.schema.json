{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/rrrrrredy/agent-memory-system/schemas/candidate-review-apply-result.schema.json",
  "title": "Candidate review apply result",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "event_id", "sequence", "record_sha256", "transitions", "privacy"],
  "properties": {
    "schema_version": {"const": "candidate-review-apply-result/v1alpha1"},
    "event_id": {"type": "string", "pattern": "^review-", "minLength": 8},
    "sequence": {"type": "integer", "minimum": 1},
    "record_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "transitions": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "candidate-review-event.schema.json#/$defs/transition"}},
    "privacy": {"const": "local_only"}
  }
}
