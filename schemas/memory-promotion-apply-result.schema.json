{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/rrrrrredy/agent-memory-system/schemas/memory-promotion-apply-result.schema.json",
  "title": "Memory promotion apply result",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "event_id", "sequence", "record_sha256", "revision", "privacy"],
  "properties": {
    "schema_version": {"const": "memory-promotion-apply-result/v1alpha1"},
    "event_id": {"type": "string", "pattern": "^promotion-", "minLength": 11},
    "sequence": {"type": "integer", "minimum": 1},
    "record_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "revision": {"$ref": "promoted-memory-revision.schema.json"},
    "privacy": {"const": "local_only"}
  }
}
