{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/rrrrrredy/agent-memory-system/schemas/agent-memory-doctor-report.schema.json",
  "title": "Agent Memory System diagnostic report",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "checked_at", "platform", "evidence", "reviews", "promotions", "rule_approvals", "retrieval", "repository_checked", "ready", "issues", "privacy"],
  "properties": {
    "schema_version": {"const": "agent-memory-doctor-report/v1alpha1"},
    "checked_at": {"type": "string", "format": "date-time"},
    "platform": {"type": "string", "pattern": "^[a-z0-9]+/[a-z0-9]+$"},
    "evidence": {"$ref": "#/$defs/evidence"},
    "reviews": {"$ref": "#/$defs/reviews"},
    "promotions": {"$ref": "#/$defs/promotions"},
    "rule_approvals": {"$ref": "#/$defs/ruleApprovals"},
    "retrieval": {"$ref": "#/$defs/retrieval"},
    "repository_checked": {"type": "boolean"},
    "git_sync": {"$ref": "git-sync-verification.schema.json"},
    "ready": {"type": "boolean"},
    "issues": {"type": "array", "items": {"$ref": "#/$defs/issue"}},
    "privacy": {"const": "local_only"}
  },
  "$defs": {
    "hash": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "stringIssues": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["records_checked", "blobs_checked", "issues"],
      "properties": {
        "records_checked": {"type": "integer", "minimum": 0},
        "blobs_checked": {"type": "integer", "minimum": 0},
        "last_record_hash": {"$ref": "#/$defs/hash"},
        "issues": {"$ref": "#/$defs/stringIssues"}
      }
    },
    "reviews": {
      "type": "object",
      "additionalProperties": false,
      "required": ["records_checked", "issues"],
      "properties": {
        "records_checked": {"type": "integer", "minimum": 0},
        "last_record_sha256": {"$ref": "#/$defs/hash"},
        "issues": {"$ref": "#/$defs/stringIssues"}
      }
    },
    "promotions": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema_version", "records_checked", "memories_checked", "issues"],
      "properties": {
        "schema_version": {"const": "memory-promotion-verification/v1alpha1"},
        "records_checked": {"type": "integer", "minimum": 0},
        "memories_checked": {"type": "integer", "minimum": 0},
        "last_record_sha256": {"$ref": "#/$defs/hash"},
        "issues": {"$ref": "#/$defs/stringIssues"}
      }
    },
    "ruleApprovals": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema_version", "records_checked", "approvals_checked", "issues"],
      "properties": {
        "schema_version": {"const": "rule-change-approval-verification/v1alpha1"},
        "records_checked": {"type": "integer", "minimum": 0},
        "approvals_checked": {"type": "integer", "minimum": 0},
        "last_record_sha256": {"$ref": "#/$defs/hash"},
        "issues": {"$ref": "#/$defs/stringIssues"}
      }
    },
    "retrieval": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema_version", "retrievals_checked", "injections_checked", "adoptions_checked", "open_retrieval_ids", "issues", "privacy"],
      "properties": {
        "schema_version": {"const": "memory-receipt-verification/v1alpha1"},
        "retrievals_checked": {"type": "integer", "minimum": 0},
        "injections_checked": {"type": "integer", "minimum": 0},
        "adoptions_checked": {"type": "integer", "minimum": 0},
        "open_retrieval_ids": {"type": "array", "items": {"type": "string", "minLength": 1}},
        "issues": {"$ref": "#/$defs/stringIssues"},
        "privacy": {"const": "local_only"}
      }
    },
    "issue": {
      "type": "object",
      "additionalProperties": false,
      "required": ["component", "code", "message"],
      "properties": {
        "component": {"type": "string", "minLength": 1},
        "code": {"type": "string", "minLength": 1},
        "message": {"type": "string", "minLength": 1}
      }
    }
  }
}
