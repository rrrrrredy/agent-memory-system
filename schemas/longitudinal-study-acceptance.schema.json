{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/rrrrrredy/agent-memory-system/schemas/longitudinal-study-acceptance.schema.json",
  "title": "Prospectively sealed longitudinal study acceptance contract",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "mode", "assertions"],
  "properties": {
    "schema_version": {"const": "longitudinal-study-acceptance/v1alpha1"},
    "mode": {"const": "all"},
    "assertions": {
      "type": "array", "minItems": 1, "maxItems": 16,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["kind", "expected_sha256"],
        "properties": {
          "kind": {"const": "agent_message_sha256"},
          "expected_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
        }
      }
    }
  }
}
