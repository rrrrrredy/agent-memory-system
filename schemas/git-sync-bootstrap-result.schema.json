{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/rrrrrredy/agent-memory-system/schemas/git-sync-bootstrap-result.schema.json",
  "title": "Portable memory Git bootstrap result",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "branch", "head", "remote_configured", "hooks_installed", "privacy"],
  "properties": {
    "schema_version": {"const": "git-sync-bootstrap-result/v1alpha1"},
    "branch": {"const": "main"},
    "head": {"type": "string", "pattern": "^[a-f0-9]{40,64}$"},
    "remote_configured": {"type": "boolean"},
    "hooks_installed": {"type": "boolean"},
    "privacy": {"const": "private_git"}
  }
}
