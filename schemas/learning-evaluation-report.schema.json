{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/rrrrrredy/agent-memory-system/schemas/learning-evaluation-report.schema.json",
  "title": "Continuous-learning evaluation report",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "evaluation_version", "suite_id", "run_id", "input_sha256",
    "input_blob", "system_version", "cases_checked", "evidence_references_checked",
    "attested_references", "capture", "false_memory", "corrections", "compaction_drift",
    "retrieval", "outcomes", "gates", "release_ready", "issues", "report_sha256", "privacy"
  ],
  "properties": {
    "schema_version": {"const": "learning-evaluation-report/v1alpha1"},
    "evaluation_version": {"const": "learning-evaluation/v1alpha1"},
    "suite_id": {"$ref": "#/$defs/identifier"},
    "run_id": {"$ref": "#/$defs/identifier"},
    "input_sha256": {"$ref": "#/$defs/sha256"},
    "input_blob": {"$ref": "evidence-event.schema.json#/$defs/blob_ref"},
    "system_version": {"type": "string", "minLength": 1},
    "corpus_id": {"type": "string", "pattern": "^corpus-[a-f0-9]{64}$"},
    "cases_checked": {"type": "integer", "minimum": 1},
    "evidence_references_checked": {"type": "integer", "minimum": 0},
    "attested_references": {"type": "integer", "minimum": 0},
    "capture": {"$ref": "#/$defs/capture_metrics"},
    "false_memory": {"$ref": "#/$defs/false_memory_metrics"},
    "corrections": {"$ref": "#/$defs/correction_metrics"},
    "compaction_drift": {"$ref": "#/$defs/drift_metrics"},
    "retrieval": {"$ref": "#/$defs/retrieval_metrics"},
    "outcomes": {"$ref": "#/$defs/outcome_metrics"},
    "gates": {"type": "array", "items": {"$ref": "#/$defs/gate"}},
    "release_ready": {"type": "boolean"},
    "issues": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "report_sha256": {"$ref": "#/$defs/sha256"},
    "privacy": {"const": "local_only"}
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "identifier": {"type": "string", "pattern": "^[A-Za-z0-9_.:-]{1,160}$"},
    "ratio": {
      "type": "object",
      "additionalProperties": false,
      "required": ["numerator", "denominator", "status"],
      "properties": {
        "numerator": {"type": "integer", "minimum": 0},
        "denominator": {"type": "integer", "minimum": 0},
        "value": {"type": "number"},
        "status": {"enum": ["measured", "not_evaluable"]}
      }
    },
    "capture_metrics": {
      "type": "object",
      "additionalProperties": false,
      "required": ["unit", "expected", "complete", "partial", "missing", "coverage", "observed_coverage"],
      "properties": {
        "unit": {"enum": ["none", "evidence_events", "legacy_rollouts"]},
        "expected": {"type": "integer", "minimum": 0},
        "complete": {"type": "integer", "minimum": 0},
        "partial": {"type": "integer", "minimum": 0},
        "missing": {"type": "integer", "minimum": 0},
        "accounted_missing": {"type": "integer", "minimum": 0},
        "coverage": {"$ref": "#/$defs/ratio"},
        "observed_coverage": {"$ref": "#/$defs/ratio"},
        "accounted_coverage": {"$ref": "#/$defs/ratio"}
      }
    },
    "false_memory_metrics": {
      "type": "object",
      "additionalProperties": false,
      "required": ["total", "supported", "false", "unknown", "false_rate", "unknown_rate"],
      "properties": {
        "total": {"type": "integer", "minimum": 0},
        "supported": {"type": "integer", "minimum": 0},
        "false": {"type": "integer", "minimum": 0},
        "unknown": {"type": "integer", "minimum": 0},
        "false_rate": {"$ref": "#/$defs/ratio"},
        "unknown_rate": {"$ref": "#/$defs/ratio"}
      }
    },
    "correction_metrics": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "eligible_followup_opportunities", "repeated_corrections",
        "repeated_corrections_after_memory", "repeated_correction_rate"
      ],
      "properties": {
        "eligible_followup_opportunities": {"type": "integer", "minimum": 0},
        "repeated_corrections": {"type": "integer", "minimum": 0},
        "repeated_corrections_after_memory": {"type": "integer", "minimum": 0},
        "repeated_correction_rate": {"$ref": "#/$defs/ratio"}
      }
    },
    "drift_metrics": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "true_positive", "false_positive", "true_negative", "false_negative",
        "excluded", "precision", "recall"
      ],
      "properties": {
        "true_positive": {"type": "integer", "minimum": 0},
        "false_positive": {"type": "integer", "minimum": 0},
        "true_negative": {"type": "integer", "minimum": 0},
        "false_negative": {"type": "integer", "minimum": 0},
        "excluded": {"type": "integer", "minimum": 0},
        "precision": {"$ref": "#/$defs/ratio"},
        "recall": {"$ref": "#/$defs/ratio"}
      }
    },
    "retrieval_metrics": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "deliveries", "selected_items", "adopted", "helpful", "neutral", "harmful",
        "unknown", "total_tokens", "total_utf8_bytes"
      ],
      "properties": {
        "deliveries": {"type": "integer", "minimum": 0},
        "selected_items": {"type": "integer", "minimum": 0},
        "adopted": {"type": "integer", "minimum": 0},
        "helpful": {"type": "integer", "minimum": 0},
        "neutral": {"type": "integer", "minimum": 0},
        "harmful": {"type": "integer", "minimum": 0},
        "unknown": {"type": "integer", "minimum": 0},
        "total_tokens": {"type": "integer", "minimum": 0},
        "mean_tokens": {"type": "number", "minimum": 0},
        "p95_tokens": {"type": "number", "minimum": 0},
        "total_utf8_bytes": {"type": "integer", "minimum": 0},
        "helpful_per_1000_tokens": {"type": "number", "minimum": 0}
      }
    },
    "outcome_metrics": {
      "type": "object",
      "additionalProperties": false,
      "required": ["pairs", "wins", "ties", "losses", "baseline_successes", "treatment_successes"],
      "properties": {
        "pairs": {"type": "integer", "minimum": 0},
        "wins": {"type": "integer", "minimum": 0},
        "ties": {"type": "integer", "minimum": 0},
        "losses": {"type": "integer", "minimum": 0},
        "baseline_successes": {"type": "integer", "minimum": 0},
        "treatment_successes": {"type": "integer", "minimum": 0},
        "mean_score_delta": {"type": "number", "minimum": -1, "maximum": 1},
        "success_rate_delta": {"type": "number", "minimum": -1, "maximum": 1},
        "mean_error_delta": {"type": "number"},
        "mean_correction_delta": {"type": "number"},
        "mean_total_token_delta": {"type": "number"}
      }
    },
    "gate": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "comparison", "threshold", "status"],
      "properties": {
        "name": {"type": "string", "minLength": 1},
        "comparison": {"enum": [">=", "<="]},
        "threshold": {"type": "number"},
        "actual": {"type": "number"},
        "status": {"enum": ["pass", "fail", "not_evaluable"]},
        "reason": {"type": "string", "minLength": 1}
      }
    }
  }
}
