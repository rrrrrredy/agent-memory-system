{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/rrrrrredy/agent-memory-system/schemas/episode-generation-audit.schema.json",
  "title": "Append-only episode generation audit",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "audit_id", "derivation_version", "source_records", "source_last_record_hash",
    "generation_name", "manifest_sha256", "episodes_sha256", "timeline_sha256", "episodes",
    "timeline_entries", "compactions", "privacy"
  ],
  "properties": {
    "schema_version": {"const": "episode-generation-audit/v1alpha1"},
    "audit_id": {"type": "string", "pattern": "^episode-generation-audit-[a-f0-9]{64}$"},
    "derivation_version": {"const": "episodes/v1alpha1"},
    "source_records": {"type": "integer", "minimum": 1},
    "source_last_record_hash": {"$ref": "learning-evaluation-input.schema.json#/$defs/sha256"},
    "generation_name": {"type": "string", "minLength": 1},
    "manifest_sha256": {"$ref": "learning-evaluation-input.schema.json#/$defs/sha256"},
    "episodes_sha256": {"$ref": "learning-evaluation-input.schema.json#/$defs/sha256"},
    "timeline_sha256": {"$ref": "learning-evaluation-input.schema.json#/$defs/sha256"},
    "episodes": {"type": "integer", "minimum": 0},
    "timeline_entries": {"type": "integer", "minimum": 0},
    "compactions": {"type": "integer", "minimum": 0},
    "privacy": {"const": "local_only"}
  }
}
