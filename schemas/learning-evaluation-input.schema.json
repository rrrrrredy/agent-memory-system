{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/rrrrrredy/agent-memory-system/schemas/learning-evaluation-input.schema.json",
  "title": "Evidence-bound continuous-learning evaluation input",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "suite_id", "run_id", "created_at", "system_version", "quality_profile",
    "cases", "thresholds", "privacy"
  ],
  "properties": {
    "schema_version": {"const": "learning-evaluation-input/v1alpha2"},
    "suite_id": {"$ref": "#/$defs/identifier"},
    "run_id": {"$ref": "#/$defs/identifier"},
    "created_at": {"type": "string", "format": "date-time"},
    "system_version": {"type": "string", "minLength": 1},
    "quality_profile": {"enum": ["component", "continuous_learning"]},
    "policy_id": {"const": "continuous-learning-policy/v1"},
    "population": {"$ref": "#/$defs/population"},
    "corpus_id": {"type": "string", "pattern": "^corpus-[a-f0-9]{64}$"},
    "cases": {"type": "array", "items": {"$ref": "#/$defs/case"}, "minItems": 1},
    "thresholds": {"$ref": "#/$defs/thresholds"},
    "privacy": {"const": "local_only"}
  },
  "$defs": {
    "identifier": {"type": "string", "pattern": "^[A-Za-z0-9_.:-]{1,160}$"},
    "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "optional_sha256": {"anyOf": [{"$ref": "#/$defs/sha256"}, {"const": ""}]},
    "agent": {"enum": ["codex", "claude_code", "opencode", "unknown"]},
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "id", "sha256"],
      "properties": {
        "kind": {"enum": ["ledger_event", "corpus_artifact", "portable_revision"]},
        "id": {"type": "string", "minLength": 1},
        "sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "capture": {
      "type": "object",
      "additionalProperties": false,
      "required": ["unit", "expected", "complete", "partial", "missing"],
      "properties": {
        "unit": {"enum": ["evidence_events", "legacy_rollouts", "source_inventory_items"]},
        "expected": {"type": "integer", "minimum": 0},
        "complete": {"type": "integer", "minimum": 0},
        "partial": {"type": "integer", "minimum": 0},
        "missing": {"type": "integer", "minimum": 0},
        "accounted_missing": {"type": "integer", "minimum": 0}
      }
    },
    "memory": {
      "type": "object",
      "additionalProperties": false,
      "required": ["memory_id", "label", "active", "retrieved"],
      "properties": {
        "memory_id": {"type": "string", "minLength": 1},
        "label": {"enum": ["supported", "incorrect", "unsupported", "stale", "unknown"]},
        "active": {"type": "boolean"},
        "retrieved": {"type": "boolean"}
      }
    },
    "correction": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "semantic_key_sha256", "initial_correction_attempt_id", "attempt_ids", "eligible_followup_opportunities", "repeated_corrections",
        "repeated_corrections_after_memory"
      ],
      "properties": {
        "semantic_key_sha256": {"$ref": "#/$defs/sha256"},
        "initial_correction_attempt_id": {"type": "string", "pattern": "^task-attempt-[a-f0-9]{64}$"},
        "attempt_ids": {
          "type": "array", "minItems": 1, "uniqueItems": true,
          "items": {"type": "string", "pattern": "^task-attempt-[a-f0-9]{64}$"}
        },
        "eligible_followup_opportunities": {"type": "integer", "minimum": 0},
        "repeated_corrections": {"type": "integer", "minimum": 0},
        "repeated_corrections_after_memory": {"type": "integer", "minimum": 0}
      }
    },
    "compaction": {
      "type": "object",
      "additionalProperties": false,
      "required": ["checkpoint_id", "expected", "observed"],
      "properties": {
        "checkpoint_id": {"type": "string", "minLength": 1},
        "expected": {"enum": ["preserved", "drift", "insufficient_evidence"]},
        "observed": {"enum": ["preserved", "drift", "insufficient_evidence"]}
      }
    },
    "retrieval": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "retrieval_id", "estimated_tokens", "utf8_bytes", "selected_items", "adopted", "outcome"
      ],
      "properties": {
        "retrieval_id": {"type": "string", "minLength": 1},
        "estimated_tokens": {"type": "integer", "minimum": 0},
        "utf8_bytes": {"type": "integer", "minimum": 0},
        "selected_items": {"type": "integer", "minimum": 0},
        "adopted": {"type": "boolean"},
        "outcome": {"enum": ["helpful", "neutral", "harmful", "unknown"]}
      }
    },
    "trial": {
      "type": "object",
      "additionalProperties": false,
      "required": ["success", "score", "errors", "user_corrections", "token_count_evaluated", "total_tokens"],
      "properties": {
        "success": {"type": "boolean"},
        "score": {"type": "number", "minimum": 0, "maximum": 1},
        "errors": {"type": "integer", "minimum": 0},
        "user_corrections": {"type": "integer", "minimum": 0},
        "token_count_evaluated": {"type": "boolean"},
        "total_tokens": {"type": "integer", "minimum": 0}
      },
      "allOf": [{
        "if": {"properties": {"token_count_evaluated": {"const": false}}, "required": ["token_count_evaluated"]},
        "then": {"properties": {"total_tokens": {"const": 0}}}
      }]
    },
    "paired_outcome": {
      "type": "object",
      "additionalProperties": false,
      "required": ["pair_id", "baseline_attempt_id", "treatment_attempt_id", "baseline", "treatment"],
      "properties": {
        "pair_id": {"$ref": "#/$defs/identifier"},
        "baseline_attempt_id": {"type": "string", "pattern": "^task-attempt-[a-f0-9]{64}$"},
        "treatment_attempt_id": {"type": "string", "pattern": "^task-attempt-[a-f0-9]{64}$"},
        "baseline": {"$ref": "#/$defs/trial"},
        "treatment": {"$ref": "#/$defs/trial"}
      }
    },
    "case_base": {
      "type": "object",
      "required": ["case_id", "category", "agent", "evidence"],
      "properties": {
        "case_id": {"$ref": "#/$defs/identifier"},
        "category": {
          "enum": [
            "capture_coverage", "false_memory", "repeated_correction",
            "compaction_drift", "retrieval_cost", "paired_outcome"
          ]
        },
        "agent": {"$ref": "#/$defs/agent"},
        "evidence": {
          "type": "array",
          "items": {"$ref": "#/$defs/evidence"},
          "minItems": 1
        }
      }
    },
    "case": {
      "allOf": [
        {"$ref": "#/$defs/case_base"},
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "case_id": {"$ref": "#/$defs/identifier"},
            "category": {},
            "agent": {"$ref": "#/$defs/agent"},
            "evidence": {"type": "array", "items": {"$ref": "#/$defs/evidence"}, "minItems": 1},
            "capture": {"$ref": "#/$defs/capture"},
            "memory": {"$ref": "#/$defs/memory"},
            "correction": {"$ref": "#/$defs/correction"},
            "compaction": {"$ref": "#/$defs/compaction"},
            "retrieval": {"$ref": "#/$defs/retrieval"},
            "paired_outcome": {"$ref": "#/$defs/paired_outcome"}
          },
          "oneOf": [
            {"required": ["capture"], "properties": {"category": {"const": "capture_coverage"}}},
            {"required": ["memory"], "properties": {"category": {"const": "false_memory"}}},
            {"required": ["correction"], "properties": {"category": {"const": "repeated_correction"}}},
            {"required": ["compaction"], "properties": {"category": {"const": "compaction_drift"}}},
            {"required": ["retrieval"], "properties": {"category": {"const": "retrieval_cost"}}},
            {"required": ["paired_outcome"], "properties": {"category": {"const": "paired_outcome"}}}
          ]
        }
      ]
    },
    "population": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version", "policy_id", "episode_derivation_version", "episodes_sha256", "timeline_sha256",
        "ledger_record_count", "ledger_last_record_hash", "portable_state_sha256", "portable_state_blob",
        "oracle_registry_sha256", "oracle_registry_blob", "system_artifact_sha256", "system_under_test_sha256",
        "capture_snapshot_sha256", "capture_snapshot_blob", "corpus_id", "corpus_content_sha256",
        "efficacy_prerequisites", "case_set_sha256", "category_counts", "required_agents",
        "unpaired_attempt_ids", "population_issues"
      ],
      "properties": {
        "schema_version": {"const": "learning-evaluation-population/v1alpha2"},
        "policy_id": {"const": "continuous-learning-policy/v1"},
        "episode_derivation_version": {"type": "string"},
        "episodes_sha256": {"$ref": "#/$defs/optional_sha256"},
        "timeline_sha256": {"$ref": "#/$defs/optional_sha256"},
        "ledger_record_count": {"type": "integer", "minimum": 1},
        "ledger_last_record_hash": {"$ref": "#/$defs/sha256"},
        "portable_state_sha256": {"$ref": "#/$defs/sha256"},
        "portable_state_blob": {"$ref": "evidence-event.schema.json#/$defs/blob_ref"},
        "oracle_registry_sha256": {"$ref": "#/$defs/sha256"},
        "oracle_registry_blob": {"$ref": "evidence-event.schema.json#/$defs/blob_ref"},
        "case_set_sha256": {"$ref": "#/$defs/sha256"},
        "system_artifact_sha256": {"$ref": "#/$defs/optional_sha256"},
        "system_under_test_sha256": {
          "type": "object", "additionalProperties": false,
          "properties": {
            "codex": {"$ref": "#/$defs/sha256"},
            "claude_code": {"$ref": "#/$defs/sha256"},
            "opencode": {"$ref": "#/$defs/sha256"}
          }
        },
        "capture_snapshot_sha256": {"$ref": "#/$defs/sha256"},
        "capture_snapshot_blob": {"$ref": "evidence-event.schema.json#/$defs/blob_ref"},
        "corpus_id": {"type": "string", "pattern": "^corpus-[a-f0-9]{64}$"},
        "corpus_content_sha256": {"$ref": "#/$defs/sha256"},
        "efficacy_prerequisites": {
          "type": "object", "additionalProperties": false,
          "required": [
            "frozen_corpus_verified", "independent_capture_inventory", "normalized_projection_coverage",
            "complete_portable_population", "preregistered_attempt_universe", "paired_trial_plan_sealed",
            "execution_supervisor_receipts", "verified_agent_execution", "system_artifact_manifest", "independent_compaction_detector",
            "sealed_compaction_ground_truth",
            "frozen_compaction_drift_control", "frozen_compaction_preserve_control", "blind_oracle_protocol",
            "hermetic_oracle_execution"
          ],
          "properties": {
            "frozen_corpus_verified": {"type": "boolean"},
            "independent_capture_inventory": {"type": "boolean"},
            "normalized_projection_coverage": {"type": "boolean"},
            "complete_portable_population": {"type": "boolean"},
            "preregistered_attempt_universe": {"type": "boolean"},
            "paired_trial_plan_sealed": {"type": "boolean"},
            "execution_supervisor_receipts": {"type": "boolean"},
            "verified_agent_execution": {"type": "boolean"},
            "system_artifact_manifest": {"type": "boolean"},
            "independent_compaction_detector": {"type": "boolean"},
            "sealed_compaction_ground_truth": {"type": "boolean"},
            "frozen_compaction_drift_control": {"type": "boolean"},
            "frozen_compaction_preserve_control": {"type": "boolean"},
            "blind_oracle_protocol": {"type": "boolean"},
            "hermetic_oracle_execution": {"type": "boolean"}
          }
        },
        "category_counts": {
          "type": "object", "additionalProperties": false,
          "required": ["capture_coverage", "false_memory", "repeated_correction", "compaction_drift", "retrieval_cost", "paired_outcome"],
          "properties": {
            "capture_coverage": {"type": "integer", "minimum": 0},
            "false_memory": {"type": "integer", "minimum": 0},
            "repeated_correction": {"type": "integer", "minimum": 0},
            "compaction_drift": {"type": "integer", "minimum": 0},
            "retrieval_cost": {"type": "integer", "minimum": 0},
            "paired_outcome": {"type": "integer", "minimum": 0}
          }
        },
        "required_agents": {
          "type": "array", "minItems": 3, "maxItems": 3,
          "prefixItems": [{"const": "codex"}, {"const": "claude_code"}, {"const": "opencode"}]
        },
        "unpaired_attempt_ids": {"type": "array", "uniqueItems": true, "items": {"type": "string", "pattern": "^task-attempt-[a-f0-9]{64}$"}},
        "population_issues": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}}
      }
    },
    "unit_interval": {"type": "number", "minimum": 0, "maximum": 1},
    "thresholds": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "minimum_capture_coverage": {"$ref": "#/$defs/unit_interval"},
        "maximum_false_memory_rate": {"$ref": "#/$defs/unit_interval"},
        "maximum_unknown_memory_rate": {"$ref": "#/$defs/unit_interval"},
        "maximum_repeated_correction_rate": {"$ref": "#/$defs/unit_interval"},
        "minimum_drift_precision": {"$ref": "#/$defs/unit_interval"},
        "minimum_drift_recall": {"$ref": "#/$defs/unit_interval"},
        "maximum_mean_retrieval_tokens": {"type": "number", "minimum": 0},
        "minimum_mean_outcome_score_delta": {"type": "number", "minimum": -1, "maximum": 1},
        "maximum_mean_correction_delta": {"type": "number"},
        "maximum_harmful_outcomes": {"type": "number", "minimum": 0},
        "minimum_correction_opportunities": {"type": "number", "minimum": 0},
        "minimum_paired_outcome_pairs": {"type": "number", "minimum": 0}
      }
    }
  },
  "allOf": [
    {
      "if": {"properties": {"quality_profile": {"const": "component"}}, "required": ["quality_profile"]},
      "then": {"properties": {"policy_id": false, "population": false}}
    },
    {
      "if": {"properties": {"quality_profile": {"const": "continuous_learning"}}, "required": ["quality_profile"]},
      "then": {
        "required": ["policy_id", "population", "corpus_id"],
        "properties": {
          "policy_id": {"const": "continuous-learning-policy/v1"},
          "population": {"$ref": "#/$defs/population"}
        }
      }
    }
  ]
}
