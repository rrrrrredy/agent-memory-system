{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/rrrrrredy/agent-memory-system/schemas/task-attempt-receipt.schema.json",
  "title": "Evidence-bound task attempt receipt",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "receipt_id", "recorded_at", "task_id", "attempt_id", "agent",
    "semantic_key_sha256", "task_spec_sha256", "acceptance_criteria_sha256",
    "execution_config_sha256", "system_artifact_sha256", "condition", "window_start", "window_end", "memory_references",
    "oracle", "verdict", "result_events", "user_messages", "measurement", "binding_status",
    "authority", "request_sha256", "privacy"
  ],
  "properties": {
    "schema_version": {"const": "task-attempt-receipt/v1alpha2"},
    "receipt_id": {"type": "string", "pattern": "^task-attempt-[a-f0-9]{64}$"},
    "recorded_at": {"type": "string", "format": "date-time"},
    "task_id": {"$ref": "learning-evaluation-input.schema.json#/$defs/identifier"},
    "attempt_id": {"$ref": "learning-evaluation-input.schema.json#/$defs/identifier"},
    "trial_plan_id": {"$ref": "learning-evaluation-input.schema.json#/$defs/identifier"},
    "trial_pair_id": {"$ref": "learning-evaluation-input.schema.json#/$defs/identifier"},
    "agent": {"enum": ["codex", "claude_code", "opencode", "deepseek_harness"]},
    "semantic_key_sha256": {"$ref": "learning-evaluation-input.schema.json#/$defs/sha256"},
    "task_spec_sha256": {"$ref": "learning-evaluation-input.schema.json#/$defs/sha256"},
    "acceptance_criteria_sha256": {"$ref": "learning-evaluation-input.schema.json#/$defs/sha256"},
    "execution_config_sha256": {"$ref": "learning-evaluation-input.schema.json#/$defs/sha256"},
    "system_artifact_sha256": {"$ref": "learning-evaluation-input.schema.json#/$defs/sha256"},
    "system_under_test_sha256": {"$ref": "learning-evaluation-input.schema.json#/$defs/sha256"},
    "system_under_test_blob": {"$ref": "evidence-event.schema.json#/$defs/blob_ref"},
    "task_spec_blob": {"$ref": "evidence-event.schema.json#/$defs/blob_ref"},
    "acceptance_criteria_blob": {"$ref": "evidence-event.schema.json#/$defs/blob_ref"},
    "execution_config_blob": {"$ref": "evidence-event.schema.json#/$defs/blob_ref"},
    "condition": {"enum": ["baseline", "memory"]},
    "window_start": {"$ref": "#/$defs/bound_event"},
    "window_end": {"$ref": "#/$defs/bound_event"},
    "retrieval_receipt_id": {"type": "string", "pattern": "^retrieval-"},
    "injection_id": {"type": "string", "pattern": "^injection-"},
    "adoption_id": {"type": "string", "pattern": "^adoption-"},
    "memory_references": {"type": "array", "uniqueItems": true, "items": {"$ref": "memory-retrieval-result.schema.json#/$defs/memory_reference"}},
    "oracle": {"$ref": "task-attempt-request.schema.json#/properties/oracle"},
    "verdict": {"$ref": "#/$defs/bound_event"},
    "result_events": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "#/$defs/bound_event"}},
    "user_messages": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/bound_event"}},
    "measurement": {"$ref": "learning-evaluation-input.schema.json#/$defs/trial"},
    "binding_status": {"const": "causal_complete"},
    "authority": {"const": "measurement_only"},
    "request_sha256": {"$ref": "learning-evaluation-input.schema.json#/$defs/sha256"},
    "privacy": {"const": "local_only"}
  },
  "dependentRequired": {
    "trial_plan_id": ["trial_pair_id"],
    "trial_pair_id": ["trial_plan_id"]
  },
  "allOf": [
    {
      "if": {"properties": {"condition": {"const": "baseline"}}},
      "then": {
        "properties": {
          "retrieval_receipt_id": false,
          "injection_id": false,
          "adoption_id": false,
          "memory_references": {"maxItems": 0}
        }
      }
    },
    {
      "if": {"properties": {"condition": {"const": "memory"}}},
      "then": {
        "required": ["retrieval_receipt_id", "injection_id", "adoption_id"],
        "properties": {"memory_references": {"minItems": 1}}
      }
    },
    {
      "if": {
        "anyOf": [
          {"required": ["task_spec_blob"]},
          {"required": ["acceptance_criteria_blob"]},
          {"required": ["execution_config_blob"]}
        ]
      },
      "then": {
        "required": [
          "task_spec_blob", "acceptance_criteria_blob", "execution_config_blob"
        ]
      }
    },
    {
      "if": {
        "anyOf": [
          {"required": ["system_under_test_sha256"]},
          {"required": ["system_under_test_blob"]}
        ]
      },
      "then": {
        "required": ["system_under_test_sha256", "system_under_test_blob"]
      }
    }
  ],
  "$defs": {
    "bound_event": {
      "type": "object", "additionalProperties": false,
      "required": ["event_id", "record_hash", "payload_sha256"],
      "properties": {
        "event_id": {"type": "string", "minLength": 1},
        "record_hash": {"$ref": "learning-evaluation-input.schema.json#/$defs/sha256"},
        "payload_sha256": {"$ref": "learning-evaluation-input.schema.json#/$defs/sha256"}
      }
    }
  }
}
