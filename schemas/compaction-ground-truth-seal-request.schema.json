{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/rrrrrredy/agent-memory-system/schemas/compaction-ground-truth-seal-request.schema.json",
  "title": "Human compaction ground-truth seal request",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "corpus_id", "reviewer_id", "reason", "labels", "privacy"],
  "properties": {
    "schema_version": {"const": "compaction-ground-truth-seal-request/v1alpha1"},
    "corpus_id": {"type": "string", "pattern": "^corpus-[a-f0-9]{64}$"},
    "reviewer_id": {"$ref": "learning-evaluation-input.schema.json#/$defs/identifier"},
    "reason": {"type": "string", "minLength": 1},
    "labels": {
      "type": "array", "minItems": 1, "uniqueItems": true,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["event_id", "expected"],
        "properties": {
          "event_id": {"type": "string", "minLength": 1},
          "expected": {"enum": ["drift", "preserved"]}
        }
      }
    },
    "privacy": {"const": "local_only"}
  }
}
