{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/rrrrrredy/agent-memory-system/schemas/task-oracle-registry.schema.json",
  "title": "Local task oracle registry",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "entries", "privacy"],
  "properties": {
    "schema_version": {"const": "task-oracle-registry/v1alpha2"},
    "entries": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/entry"}
    },
    "privacy": {"const": "local_only"}
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "identifier": {"type": "string", "pattern": "^[A-Za-z0-9_.:-]{1,160}$"},
    "entry": {
      "oneOf": [{"$ref": "#/$defs/harness_entry"}, {"$ref": "#/$defs/builtin_entry"}]
    },
    "harness_entry": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind", "id", "version", "executable", "executable_sha256", "arguments", "timeout_seconds"
      ],
      "properties": {
        "kind": {"const": "harness"},
        "id": {"$ref": "#/$defs/identifier"},
        "version": {"type": "string", "minLength": 1},
        "executable": {"type": "string", "minLength": 1},
        "executable_sha256": {"$ref": "#/$defs/sha256"},
        "arguments": {
          "type": "array",
          "items": {"type": "string", "maxLength": 16384}
        },
        "timeout_seconds": {"type": "integer", "minimum": 1, "maximum": 600}
      }
    },
    "builtin_entry": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind", "id", "version", "executable", "executable_sha256", "arguments", "timeout_seconds"
      ],
      "properties": {
        "kind": {"const": "builtin"},
        "id": {"const": "evidence-score"},
        "version": {"const": "v1"},
        "executable": {"const": ""},
        "executable_sha256": {"const": ""},
        "arguments": {"type": "array", "maxItems": 0},
        "timeout_seconds": {"const": 0}
      }
    }
  }
}
