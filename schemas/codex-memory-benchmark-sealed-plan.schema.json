{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/rrrrrredy/agent-memory-system/schemas/codex-memory-benchmark-sealed-plan.schema.json",
  "title": "Sealed Codex memory benchmark plan",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "plan_sha256", "suite_id", "model", "timeout_seconds", "codex_executable",
    "codex_version", "runner_version", "runner_executable", "environment_policy", "environment_names_sha256",
    "environment_names_count", "input_plan_blob", "created_at", "tasks", "privacy"
  ],
  "properties": {
    "schema_version": {"const": "codex-memory-benchmark-sealed-plan/v1alpha1"},
    "plan_sha256": {"$ref": "#/$defs/sha256"},
    "suite_id": {"$ref": "codex-memory-benchmark-plan.schema.json#/$defs/identifier"},
    "model": {"type": "string", "minLength": 1},
    "timeout_seconds": {"type": "integer", "minimum": 30, "maximum": 3600},
    "codex_executable": {"$ref": "#/$defs/artifact"},
    "codex_version": {"type": "string", "minLength": 1},
    "runner_version": {"const": "codex-memory-benchmark/v1alpha1"},
    "runner_executable": {"$ref": "#/$defs/artifact"},
    "environment_policy": {"type": "string", "minLength": 1},
    "environment_names_sha256": {"$ref": "#/$defs/sha256"},
    "environment_names_count": {"type": "integer", "minimum": 0},
    "input_plan_blob": {"$ref": "evidence-event.schema.json#/$defs/blob_ref"},
    "created_at": {"type": "string", "format": "date-time"},
    "tasks": {"type": "array", "minItems": 1, "maxItems": 50, "items": {"$ref": "#/$defs/task"}},
    "privacy": {"const": "local_only"}
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "artifact": {
      "type": "object", "additionalProperties": false,
      "required": ["path", "sha256", "bytes", "blob"],
      "properties": {
        "path": {"type": "string", "minLength": 1},
        "sha256": {"$ref": "#/$defs/sha256"},
        "bytes": {"type": "integer", "minimum": 0, "maximum": 268435456},
        "blob": {"$ref": "evidence-event.schema.json#/$defs/blob_ref"}
      }
    },
    "task": {
      "type": "object", "additionalProperties": false,
      "required": [
        "task_id", "cluster_id", "prompt_sha256", "memory_sha256", "memory_source", "tool_policy", "memory_references",
        "workspace_sha256", "workspace_files", "oracle_overlay_sha256", "oracle_files",
        "oracle_executable", "oracle_arguments", "execution_order"
      ],
      "properties": {
        "task_id": {"$ref": "codex-memory-benchmark-plan.schema.json#/$defs/identifier"},
        "cluster_id": {"$ref": "codex-memory-benchmark-plan.schema.json#/$defs/identifier"},
        "prompt_sha256": {"$ref": "#/$defs/sha256"},
        "memory_sha256": {"$ref": "#/$defs/sha256"},
        "memory_source": {"enum": ["caller_provided", "verified_injection"]},
        "tool_policy": {"enum": ["forbid", "allow"]},
        "injection_id": {"type": "string", "pattern": "^injection-.+"},
        "retrieval_receipt_id": {"type": "string", "pattern": "^retrieval-.+"},
        "memory_references": {"type": "array", "uniqueItems": true, "items": {"$ref": "memory-retrieval-result.schema.json#/$defs/memory_reference"}},
        "workspace_sha256": {"$ref": "#/$defs/sha256"},
        "workspace_files": {"type": "array", "maxItems": 4096, "items": {"$ref": "#/$defs/artifact"}},
        "oracle_overlay_sha256": {"$ref": "#/$defs/sha256"},
        "oracle_files": {"type": "array", "maxItems": 4096, "items": {"$ref": "#/$defs/artifact"}},
        "oracle_executable": {"$ref": "#/$defs/artifact"},
        "oracle_arguments": {"type": "array", "maxItems": 63, "items": {"type": "string"}},
        "execution_order": {
          "oneOf": [
            {"const": ["baseline", "memory"]},
            {"const": ["memory", "baseline"]}
          ]
        }
      },
      "allOf": [
        {
          "if": {"properties": {"memory_source": {"const": "verified_injection"}}},
          "then": {"required": ["injection_id", "retrieval_receipt_id"], "properties": {"memory_references": {"minItems": 1}}}
        },
        {
          "if": {"properties": {"memory_source": {"const": "caller_provided"}}},
          "then": {
            "properties": {"memory_references": {"maxItems": 0}},
            "not": {"anyOf": [{"required": ["injection_id"]}, {"required": ["retrieval_receipt_id"]}]}
          }
        }
      ]
    }
  }
}
