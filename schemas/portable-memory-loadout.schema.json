{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/rrrrrredy/agent-memory-system/schemas/portable-memory-loadout.schema.json",
  "title": "Immutable portable memory loadout",
  "$ref": "#/$defs/loadout",
  "$defs": {
    "memory_reference": {
      "type": "object",
      "additionalProperties": false,
      "required": ["memory_id", "revision_id"],
      "properties": {
        "memory_id": {"type": "string", "pattern": "^memory-[a-f0-9]{64}$"},
        "revision_id": {"type": "string", "pattern": "^portable-revision-[a-f0-9]{64}$"}
      }
    },
    "loadout": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version", "loadout_id", "name", "agents", "scope_kind", "scope_value",
        "memories", "token_budget", "byte_budget", "privacy"
      ],
      "properties": {
        "schema_version": {"const": "portable-memory-loadout/v1alpha1"},
        "loadout_id": {"type": "string", "pattern": "^loadout-[a-f0-9]{64}$"},
        "name": {
          "type": "string", "minLength": 1, "maxLength": 128,
          "pattern": "^[^\\x00\\r\\n]+$"
        },
        "description": {
          "type": "string", "maxLength": 1024,
          "pattern": "^[^\\x00\\r]*$"
        },
        "agents": {
          "type": "array", "minItems": 1, "maxItems": 3, "uniqueItems": true,
          "items": {"enum": ["codex", "claude_code", "opencode"]}
        },
        "scope_kind": {"enum": ["global", "agent", "repository", "project", "task"]},
        "scope_value": {"type": "string", "minLength": 1, "maxLength": 4096},
        "memories": {
          "type": "array", "minItems": 1, "maxItems": 64, "uniqueItems": true,
          "items": {"$ref": "#/$defs/memory_reference"}
        },
        "token_budget": {"type": "integer", "minimum": 1, "maximum": 8192},
        "byte_budget": {"type": "integer", "minimum": 1, "maximum": 131072},
        "privacy": {"const": "private_git"}
      },
      "allOf": [
        {
          "if": {"properties": {"scope_kind": {"const": "global"}}, "required": ["scope_kind"]},
          "then": {"properties": {"scope_value": {"const": "*"}}}
        }
      ]
    }
  }
}
