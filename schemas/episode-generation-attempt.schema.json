{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/rrrrrredy/agent-memory-system/schemas/episode-generation-attempt.schema.json",
  "title": "Episode generation attempt committed before detector computation",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "attempt_id", "derivation_version", "source_records",
    "source_last_record_hash", "started_at", "privacy"
  ],
  "properties": {
    "schema_version": {"const": "episode-generation-attempt/v1alpha1"},
    "attempt_id": {"type": "string", "pattern": "^episode-generation-attempt-[a-f0-9]{64}$"},
    "derivation_version": {"const": "episodes/v1alpha2"},
    "source_records": {"type": "integer", "minimum": 0},
    "source_last_record_hash": {
      "type": "string",
      "pattern": "^$|^[a-f0-9]{64}$"
    },
    "started_at": {"type": "string", "format": "date-time"},
    "privacy": {"const": "local_only"}
  }
}
