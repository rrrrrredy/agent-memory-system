{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/rrrrrredy/agent-memory-system/schemas/portable-memory-verification.schema.json",
  "title": "Portable memory verification report",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "files_checked", "revisions_checked", "memories_checked", "active_memories", "revoked_memories", "issues", "privacy"],
  "properties": {
    "schema_version": {"const": "portable-memory-verification/v1alpha1"},
    "files_checked": {"type": "integer", "minimum": 0},
    "revisions_checked": {"type": "integer", "minimum": 0},
    "memories_checked": {"type": "integer", "minimum": 0},
    "active_memories": {"type": "integer", "minimum": 0},
    "revoked_memories": {"type": "integer", "minimum": 0},
    "issues": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["code", "message"],
        "properties": {
          "code": {"type": "string", "minLength": 1},
          "memory_id": {"type": "string", "pattern": "^memory-[a-f0-9]{64}$"},
          "revision_id": {"type": "string", "pattern": "^portable-revision-[a-f0-9]{64}$"},
          "related_memory_ids": {"type": "array", "items": {"type": "string", "pattern": "^memory-[a-f0-9]{64}$"}, "uniqueItems": true},
          "related_revision_ids": {"type": "array", "items": {"type": "string", "pattern": "^portable-revision-[a-f0-9]{64}$"}, "uniqueItems": true},
          "message": {"type": "string", "minLength": 1}
        }
      }
    },
    "privacy": {"const": "private_git"}
  }
}
