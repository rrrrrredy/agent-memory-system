{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/rrrrrredy/agent-memory-system/schemas/codex-memory-benchmark-plan.schema.json",
  "title": "Codex memory benchmark plan",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "suite_id", "model", "timeout_seconds", "tasks", "privacy"],
  "properties": {
    "schema_version": {"const": "codex-memory-benchmark-plan/v1alpha1"},
    "suite_id": {"$ref": "#/$defs/identifier"},
    "model": {"type": "string", "minLength": 1, "maxLength": 256},
    "timeout_seconds": {"type": "integer", "minimum": 30, "maximum": 3600},
    "tasks": {"type": "array", "minItems": 1, "maxItems": 50, "items": {"$ref": "#/$defs/task"}},
    "privacy": {"const": "local_only"}
  },
  "$defs": {
    "identifier": {"type": "string", "pattern": "^[a-z0-9._-]{1,128}$"},
    "relative_path": {
      "type": "string", "minLength": 1, "maxLength": 4096,
      "pattern": "^[^\\\\:]+$",
      "not": {"anyOf": [{"pattern": "^\\.$"}, {"pattern": "^\\.\\.$"}, {"pattern": "^\\.\\./"}, {"pattern": "^/"}]}
    },
    "task": {
      "type": "object",
      "additionalProperties": false,
      "required": ["task_id", "cluster_id", "prompt", "tool_policy", "workspace", "oracle_overlay", "oracle_command"],
      "properties": {
        "task_id": {"$ref": "#/$defs/identifier"},
        "cluster_id": {"$ref": "#/$defs/identifier"},
        "prompt": {"type": "string", "minLength": 1, "maxLength": 65536},
        "tool_policy": {"enum": ["forbid", "allow"]},
        "memory_context": {"type": "string", "minLength": 1, "maxLength": 65536},
        "injection_id": {"type": "string", "pattern": "^injection-.+", "maxLength": 512},
        "workspace": {"$ref": "#/$defs/relative_path"},
        "oracle_overlay": {"$ref": "#/$defs/relative_path"},
        "oracle_command": {
          "type": "array", "minItems": 1, "maxItems": 64,
          "prefixItems": [{"type": "string", "minLength": 1, "maxLength": 4096}],
          "items": {"type": "string", "maxLength": 4096, "pattern": "^[^/\\\\:\\r\\n]*$"}
        }
      },
      "oneOf": [
        {"required": ["memory_context"], "not": {"required": ["injection_id"]}},
        {"required": ["injection_id"], "not": {"required": ["memory_context"]}}
      ]
    }
  }
}
