{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/rrrrrredy/agent-memory-system/schemas/agentmem-release-provenance.schema.json",
  "title": "Release candidate provenance",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "version", "commit", "observed_main", "ref", "repository", "workflow_run_id", "sha256sums_sha256", "required_checks_sha256", "windows_acceptance_sha256", "macos_acceptance_sha256", "linux_acceptance_sha256", "required_checks", "hosted_acceptance"],
  "properties": {
    "schema_version": {"const": "agentmem-release-provenance/v1alpha2"},
    "version": {"type": "string", "pattern": "^v[0-9]+\\.[0-9]+\\.[0-9]+(?:-[0-9A-Za-z.-]+)?$"},
    "commit": {"type": "string", "pattern": "^[a-f0-9]{40}$"},
    "observed_main": {"type": "string", "pattern": "^[a-f0-9]{40}$"},
    "ref": {"const": "refs/heads/main"},
    "repository": {"const": "rrrrrredy/agent-memory-system"},
    "workflow_run_id": {"type": "string", "pattern": "^[0-9]+$"},
    "sha256sums_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "required_checks_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "windows_acceptance_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "macos_acceptance_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "linux_acceptance_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "required_checks": {"$ref": "agentmem-required-checks.schema.json"},
    "hosted_acceptance": {
      "type": "array",
      "minItems": 3,
      "maxItems": 3,
      "uniqueItems": true,
      "items": {"$ref": "agentmem-candidate-acceptance.schema.json"},
      "allOf": [
        {"contains": {"properties": {"os": {"const": "windows"}}, "required": ["os"]}, "minContains": 1, "maxContains": 1},
        {"contains": {"properties": {"os": {"const": "macos"}}, "required": ["os"]}, "minContains": 1, "maxContains": 1},
        {"contains": {"properties": {"os": {"const": "linux"}}, "required": ["os"]}, "minContains": 1, "maxContains": 1}
      ]
    }
  }
}
