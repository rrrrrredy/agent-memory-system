{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/rrrrrredy/agent-memory-system/schemas/system-under-test-manifest.schema.json",
  "title": "Task system-under-test manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "agent", "provider", "model", "system_prompt_sha256",
    "system_prompt_blob", "tool_registry_sha256", "tool_registry_blob",
    "harness_sha256", "harness_blob", "adapter_sha256", "adapter_blob", "privacy"
  ],
  "properties": {
    "schema_version": {"const": "system-under-test-manifest/v1alpha2"},
    "agent": {"enum": ["codex", "claude_code", "opencode"]},
    "provider": {"type": "string", "minLength": 1, "maxLength": 160},
    "model": {"type": "string", "minLength": 1, "maxLength": 160},
    "system_prompt_sha256": {"$ref": "learning-evaluation-input.schema.json#/$defs/sha256"},
    "system_prompt_blob": {"$ref": "evidence-event.schema.json#/$defs/blob_ref"},
    "tool_registry_sha256": {"$ref": "learning-evaluation-input.schema.json#/$defs/sha256"},
    "tool_registry_blob": {"$ref": "evidence-event.schema.json#/$defs/blob_ref"},
    "harness_sha256": {"$ref": "learning-evaluation-input.schema.json#/$defs/sha256"},
    "harness_blob": {"$ref": "evidence-event.schema.json#/$defs/blob_ref"},
    "adapter_sha256": {"$ref": "learning-evaluation-input.schema.json#/$defs/sha256"},
    "adapter_blob": {"$ref": "evidence-event.schema.json#/$defs/blob_ref"},
    "privacy": {"const": "local_only"}
  }
}
