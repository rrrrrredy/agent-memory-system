{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/rrrrrredy/agent-memory-system/schemas/agent-compatibility-report.schema.json",
  "title": "Agent runtime compatibility report",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "generated_at", "ready", "agents", "privacy"],
  "properties": {
    "schema_version": {"const": "agent-compatibility-report/v1alpha2"},
    "generated_at": {"type": "string", "format": "date-time"},
    "ready": {"type": "boolean"},
    "agents": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "agent", "command", "runtime_status", "history_import_available", "capture_modes", "retrieval_modes",
          "native_execution_verified", "execution_evidence", "provider_independently_attested", "limitations"
        ],
        "properties": {
          "agent": {"enum": ["codex", "claude_code", "opencode", "deepseek_harness"]},
          "command": {"type": "string", "minLength": 1},
          "runtime_status": {"enum": ["available", "blocked", "not_found"]},
          "runtime_issue": {
            "enum": [
              "command_not_found", "executable_read_failed", "version_probe_staging_failed",
              "version_probe_timeout", "version_probe_failed", "empty_version_output"
            ]
          },
          "version": {"type": "string", "minLength": 1, "maxLength": 4096},
          "executable_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
          "history_import_available": {"type": "boolean"},
          "capture_modes": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
          "retrieval_modes": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
          "native_execution_verified": {"type": "boolean"},
          "execution_evidence": {
            "enum": [
              "not_verified", "local_replayable_receipt", "adapter_protocol_only",
              "hosted_runtime_smoke_only", "community_bundle_protocol_only", "unsupported"
            ]
          },
          "provider_independently_attested": {"const": false},
          "limitations": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true}
        },
        "allOf": [
          {
            "if": {"properties": {"runtime_status": {"const": "available"}}, "required": ["runtime_status"]},
            "then": {"required": ["version"], "not": {"required": ["runtime_issue"]}}
          },
          {
            "if": {"properties": {"runtime_status": {"enum": ["blocked", "not_found"]}}, "required": ["runtime_status"]},
            "then": {"required": ["runtime_issue"]}
          },
          {
            "if": {"properties": {"execution_evidence": {"const": "local_replayable_receipt"}}, "required": ["execution_evidence"]},
            "then": {"properties": {"native_execution_verified": {"const": true}}}
          },
          {
            "if": {"properties": {"native_execution_verified": {"const": true}}, "required": ["native_execution_verified"]},
            "then": {"properties": {"execution_evidence": {"const": "local_replayable_receipt"}}}
          }
        ]
      }
    },
    "privacy": {"const": "local_only"}
  }
}
