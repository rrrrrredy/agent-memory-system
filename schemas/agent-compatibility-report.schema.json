{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/rrrrrredy/agent-memory-system/schemas/agent-compatibility-report.schema.json",
  "title": "Agent runtime compatibility report",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "generated_at", "ready", "agents", "privacy"],
  "properties": {
    "schema_version": {"const": "agent-compatibility-report/v1alpha1"},
    "generated_at": {"type": "string", "format": "date-time"},
    "ready": {"type": "boolean"},
    "agents": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "agent", "command", "runtime_status", "capture_modes", "retrieval_modes",
          "native_execution_verified", "limitations"
        ],
        "properties": {
          "agent": {"enum": ["codex", "claude_code", "opencode"]},
          "command": {"type": "string", "minLength": 1},
          "runtime_status": {"enum": ["available", "blocked", "not_found"]},
          "runtime_issue": {
            "enum": ["command_not_found", "version_probe_timeout", "version_probe_failed", "empty_version_output"]
          },
          "version": {"type": "string", "minLength": 1, "maxLength": 4096},
          "executable_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
          "capture_modes": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
          "retrieval_modes": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
          "native_execution_verified": {"type": "boolean"},
          "limitations": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true}
        },
        "allOf": [
          {
            "if": {"properties": {"runtime_status": {"const": "available"}}, "required": ["runtime_status"]},
            "then": {"required": ["version"], "not": {"required": ["runtime_issue"]}}
          },
          {
            "if": {"properties": {"runtime_status": {"enum": ["blocked", "not_found"]}}, "required": ["runtime_status"]},
            "then": {"required": ["runtime_issue"]}
          }
        ]
      }
    },
    "privacy": {"const": "local_only"}
  }
}
