{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/rrrrrredy/agent-memory-system/schemas/evaluation-trial-corpus-selection.schema.json",
  "title": "Deterministic frozen-corpus trial selection",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "corpus_id", "corpus_content_sha256", "seed_sha256", "items", "privacy"
  ],
  "properties": {
    "schema_version": {"const": "evaluation-trial-corpus-selection/v1alpha1"},
    "corpus_id": {"type": "string", "pattern": "^corpus-[a-f0-9]{64}$"},
    "corpus_content_sha256": {"$ref": "learning-evaluation-input.schema.json#/$defs/sha256"},
    "seed_sha256": {"$ref": "learning-evaluation-input.schema.json#/$defs/sha256"},
    "items": {
      "type": "array", "minItems": 1, "maxItems": 20, "uniqueItems": true,
      "items": {"$ref": "#/$defs/item"}
    },
    "privacy": {"const": "local_only"}
  },
  "$defs": {
    "item": {
      "type": "object",
      "additionalProperties": false,
      "required": ["artifact_id", "artifact_sha256", "blob", "agent", "pair_id", "task_id"],
      "properties": {
        "artifact_id": {"$ref": "learning-evaluation-input.schema.json#/$defs/identifier"},
        "artifact_sha256": {"$ref": "learning-evaluation-input.schema.json#/$defs/sha256"},
        "blob": {"$ref": "evidence-event.schema.json#/$defs/blob_ref"},
        "agent": {"enum": ["codex", "claude_code", "opencode", "deepseek_harness"]},
        "pair_id": {"$ref": "learning-evaluation-input.schema.json#/$defs/identifier"},
        "task_id": {"$ref": "learning-evaluation-input.schema.json#/$defs/identifier"}
      }
    }
  }
}
